<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>sibarum.elektro.queue</groupId>
        <artifactId>elektroq</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>elektroq-example</artifactId>
    <packaging>jar</packaging>

    <description>
        End-to-end demo and native-image smoke test: @Message records processed by the
        codegen annotation processor, exchanged over TCP between two conduits. Builds to
        a self-verifying native binary that exits non-zero on any failure.
    </description>

    <properties>
        <native.mainClass>sibarum.elektro.queue.example.NativeDemo</native.mainClass>
        <native.imageName>elektroq-native</native.imageName>
        <!-- Overridden to ".exe" on Windows by the windows-exe profile below. -->
        <native.exe.suffix></native.exe.suffix>
    </properties>

    <dependencies>
        <dependency>
            <groupId>sibarum.elektro.queue</groupId>
            <artifactId>elektroq-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>sibarum.elektro.queue</groupId>
            <artifactId>elektroq-transport-tcp</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>elektroq-example</finalName>
        <plugins>
            <!-- Run the codec generator at compile time. Declaring it on the processor
                 path (not the classpath) is required since JDK 23 no longer auto-discovers
                 classpath processors, and keeps it out of the runtime/native image. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>sibarum.elektro.queue</groupId>
                            <artifactId>elektroq-codegen</artifactId>
                            <version>1.0-SNAPSHOT</version>
                        </path>
                        <path>
                            <groupId>sibarum.elektro.queue</groupId>
                            <artifactId>elektroq-core</artifactId>
                            <version>1.0-SNAPSHOT</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${native.mainClass}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `mvn -Pnative verify` builds the native image and runs it as an
             integration check; a non-zero exit from the binary fails the build.
             Requires a GraalVM JDK and (on Windows) the MSVC toolchain. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${native.imageName}</imageName>
                            <mainClass>${native.mainClass}</mainClass>
                            <fallback>false</fallback>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>run-native-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.build.directory}/${native.imageName}${native.exe.suffix}</executable>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Auto-activates on Windows so the native binary is invoked with its .exe suffix. -->
        <profile>
            <id>windows-exe</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <native.exe.suffix>.exe</native.exe.suffix>
            </properties>
        </profile>
    </profiles>

</project>
