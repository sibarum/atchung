<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>elektroq</artifactId>
    <groupId>sibarum.elektro.queue</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>elektroq-example</artifactId>
  <description>End-to-end demo and native-image smoke test: @Message records processed by the
        codegen annotation processor, exchanged over TCP between two conduits. Builds to
        a self-verifying native binary that exits non-zero on any failure.</description>
  <build>
    <finalName>elektroq-example</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>sibarum.elektro.queue</groupId>
              <artifactId>elektroq-codegen</artifactId>
              <version>1.0-SNAPSHOT</version>
            </path>
            <path>
              <groupId>sibarum.elektro.queue</groupId>
              <artifactId>elektroq-core</artifactId>
              <version>1.0-SNAPSHOT</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>${native.mainClass}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>0.10.3</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <imageName>${native.imageName}</imageName>
              <mainClass>${native.mainClass}</mainClass>
              <fallback>false</fallback>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>run-native-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.build.directory}/${native.imageName}${native.exe.suffix}</executable>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>windows-exe</id>
      <properties>
        <native.exe.suffix>.exe</native.exe.suffix>
      </properties>
    </profile>
  </profiles>
  <properties>
    <native.mainClass>sibarum.elektro.queue.example.NativeDemo</native.mainClass>
    <native.imageName>elektroq-native</native.imageName>
  </properties>
</project>
