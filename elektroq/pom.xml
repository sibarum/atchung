<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.elektro.queue</groupId>
    <artifactId>elektroq</artifactId>
    <version>1.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <surefire.version>3.5.2</surefire.version>
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <!-- intrabuf: the envelope's header roles, and intrabuf-backed message types. Installed to the
             local .m2 by `mvn install` in the sibling intrabuf repo. -->
        <intrabuf.version>0.1.2-SNAPSHOT</intrabuf.version>
        <atchung.version>1.2-SNAPSHOT</atchung.version>
    </properties>

    <modules>
        <module>elektroq-core</module>
        <module>elektroq-codegen</module>
        <module>elektroq-transport-tcp</module>
        <module>elektroq-transport-uds</module>
        <module>elektroq-transport-local</module>
        <module>elektroq-netcode</module>
        <module>elektroq-example</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>